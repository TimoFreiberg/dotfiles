#!/usr/bin/env python3
"""ticket-context: print the Jira ticket context for the current jj change.

Collects Jira keys (e.g. ABC-123) from the descriptions and bookmarks of
`trunk()..@` and prints, per ticket: summary, type, status, URL, parent,
description (as Markdown), child tickets, and linked Confluence pages. A
ticket's parent is printed in full too, since the architecture usually lives
there. With no keys it exits without any network call.

Usage: ticket-context [KEY ...]   (explicit keys skip the jj scan)

Exit status:
  0  ticket context printed
  1  "No ticket: <reason>"
  2  lookup failed (missing env, jj or HTTP error); message on stderr

Env: JIRA_URL (https://<site>.atlassian.net), JIRA_USER_EMAIL, JIRA_API_TOKEN
"""
import base64
import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request

KEY_RE = re.compile(r"\b[A-Z][A-Z0-9]{1,9}-[0-9]+\b")
# Uppercase-dash-number tokens that are not Jira tickets.
NOT_TICKETS = {"UTF", "SHA", "ISO", "RFC", "CVE", "HTTP", "TLS", "AES", "MD", "X"}
JJ_TEMPLATE = 'description ++ "\\n" ++ bookmarks.map(|b| b.name()).join(" ") ++ "\\n"'
FIELDS = "summary,status,issuetype,parent,description"


def fail(msg):
    print(f"ticket-context: {msg}", file=sys.stderr)
    sys.exit(2)


def no_ticket(reason):
    print(f"No ticket: {reason}")
    sys.exit(1)


def extract_keys(text):
    seen = []
    for key in KEY_RE.findall(text):
        if key.split("-")[0] not in NOT_TICKETS and key not in seen:
            seen.append(key)
    return seen


def keys_from_jj():
    try:
        out = subprocess.run(
            ["jj", "log", "--no-graph", "--ignore-working-copy",
             "-r", "trunk()..@", "-T", JJ_TEMPLATE],
            capture_output=True, text=True, check=True, timeout=20,
        ).stdout
    except FileNotFoundError:
        fail("jj not found")
    except subprocess.CalledProcessError as e:
        if "no jj repo" in e.stderr.lower():
            no_ticket("not in a jj repo")
        fail(f"jj log failed: {e.stderr.strip()}")
    return extract_keys(out)


class Jira:
    def __init__(self):
        env = {k: os.environ.get(k, "") for k in
               ("JIRA_URL", "JIRA_USER_EMAIL", "JIRA_API_TOKEN")}
        missing = [k for k, v in env.items() if not v]
        if missing:
            fail("missing env: " + ", ".join(missing))
        self.base = env["JIRA_URL"].rstrip("/")
        token = f"{env['JIRA_USER_EMAIL']}:{env['JIRA_API_TOKEN']}".encode()
        self.auth = "Basic " + base64.b64encode(token).decode()

    def call(self, path, body=None, missing_ok=False):
        headers = {"Authorization": self.auth, "Accept": "application/json"}
        data = None
        if body is not None:
            data = json.dumps(body).encode()
            headers["Content-Type"] = "application/json"
        req = urllib.request.Request(self.base + path, data=data, headers=headers)
        try:
            with urllib.request.urlopen(req, timeout=15) as resp:
                return json.load(resp)
        except urllib.error.HTTPError as e:
            if missing_ok and e.code == 404:
                return None
            fail(f"Jira {path.split('?')[0]} returned HTTP {e.code}")
        except (urllib.error.URLError, TimeoutError) as e:
            fail(f"Jira request failed: {e}")

    def issue(self, key):
        q = urllib.parse.quote(key)
        return self.call(f"/rest/api/3/issue/{q}?fields={FIELDS}", missing_ok=True)

    def children(self, key):
        body = {"jql": f"parent = {key} ORDER BY rank",
                "fields": ["summary", "status", "issuetype"], "maxResults": 100}
        return self.call("/rest/api/3/search/jql", body).get("issues", [])

    def remote_links(self, key):
        q = urllib.parse.quote(key)
        return self.call(f"/rest/api/3/issue/{q}/remotelink", missing_ok=True) or []


# Atlassian Document Format -> Markdown, covering the nodes tickets use.
def adf(node, depth=0):
    t = node.get("type")
    kids = node.get("content", [])
    inner = lambda sep="": sep.join(adf(k, depth) for k in kids)
    if t == "doc":
        return "\n\n".join(adf(k, depth) for k in kids)
    if t == "text":
        text = node.get("text", "")
        for m in node.get("marks", []):
            if m["type"] == "code":
                text = f"`{text}`"
            elif m["type"] == "strong":
                text = f"**{text}**"
            elif m["type"] == "em":
                text = f"*{text}*"
            elif m["type"] == "link":
                text = f"[{text}]({m['attrs'].get('href', '')})"
        return text
    if t == "paragraph":
        return inner()
    if t == "heading":
        return "#" * (node.get("attrs", {}).get("level", 1) + 3) + " " + inner()
    if t in ("bulletList", "orderedList"):
        lines = []
        for i, item in enumerate(kids, 1):
            mark = f"{i}." if t == "orderedList" else "-"
            body = "\n".join(adf(k, depth + 1) for k in item.get("content", []))
            lines.append("  " * depth + f"{mark} {body.lstrip()}")
        return "\n".join(lines)
    if t == "taskList":
        return "\n".join(adf(k, depth) for k in kids)
    if t == "taskItem":
        box = "x" if node.get("attrs", {}).get("state") == "DONE" else " "
        return "  " * depth + f"- [{box}] " + inner()
    if t == "codeBlock":
        lang = node.get("attrs", {}).get("language") or ""
        return f"```{lang}\n{inner()}\n```"
    if t in ("blockquote", "panel"):
        return "\n".join("> " + line for line in inner("\n\n").splitlines())
    if t == "rule":
        return "---"
    if t == "hardBreak":
        return "\n"
    if t in ("inlineCard", "blockCard", "embedCard"):
        return node.get("attrs", {}).get("url", "")
    if t == "mention":
        return node.get("attrs", {}).get("text", "@someone")
    if t == "emoji":
        return node.get("attrs", {}).get("shortName", "")
    if t in ("status", "date"):
        a = node.get("attrs", {})
        return f"[{a.get('text') or a.get('timestamp', '')}]"
    if t == "table":
        rows = [[adf(c, depth).replace("\n", " ") for c in r.get("content", [])]
                for r in kids]
        if not rows:
            return ""
        out = ["| " + " | ".join(rows[0]) + " |",
               "|" + "---|" * len(rows[0])]
        out += ["| " + " | ".join(r) + " |" for r in rows[1:]]
        return "\n".join(out)
    if t in ("mediaSingle", "mediaGroup", "media"):
        return "(attachment)"
    return inner()


def linked_pages(description_md, remote):
    pages = []
    for r in remote:
        obj = r.get("object", {})
        url = obj.get("url", "")
        app = (r.get("application") or {}).get("type", "")
        if "/wiki/" in url or "confluence" in app.lower():
            pages.append(f"{obj.get('title') or 'page'}: {url}")
    for url in re.findall(r"https://[^\s)\]]+/wiki/[^\s)\]]+", description_md):
        if not any(url in p for p in pages):
            pages.append(url)
    return pages


def render(jira, key, issue, note=""):
    f = issue["fields"]
    desc = adf(f["description"]).strip() if f.get("description") else ""
    print(f"## {key} · {f['issuetype']['name']} · {f['status']['name']}{note}")
    print(f["summary"])
    print(f"URL: {jira.base}/browse/{key}")
    parent = f.get("parent")
    if parent:
        pf = parent.get("fields", {})
        print(f"Parent: {parent['key']} ({pf.get('issuetype', {}).get('name', '?')}) "
              f"{pf.get('summary', '')}")
    pages = linked_pages(desc, jira.remote_links(key))
    if pages:
        print("Linked pages:")
        for p in pages:
            print(f"- {p}")
    print("\n### Description\n")
    print(desc or "(empty)")
    children = jira.children(key)
    if children:
        print("\n### Child tickets\n")
        for c in children:
            cf = c["fields"]
            print(f"- {c['key']} [{cf['status']['name']}] {cf['summary']}")
    print()
    return parent["key"] if parent else None


def main():
    args = sys.argv[1:]
    if args and args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return
    keys = extract_keys(" ".join(args)) if args else keys_from_jj()
    if not keys:
        no_ticket("no Jira key in trunk()..@ descriptions or bookmarks")
    jira = Jira()
    shown, parents, missing = set(), {}, []
    for key in keys:
        issue = jira.issue(key)
        if issue is None:
            missing.append(key)
            continue
        shown.add(key)
        p = render(jira, key, issue)
        if p and p not in parents:
            parents[p] = key
    for p, child in parents.items():
        if p in shown:
            continue
        issue = jira.issue(p)
        if issue is not None:
            shown.add(p)
            render(jira, p, issue, note=f" · parent of {child}")
    if missing:
        print(f"Not found in Jira (likely not ticket keys): {', '.join(missing)}")
    if not shown:
        no_ticket("none of " + ", ".join(keys) + " exist in Jira")


if __name__ == "__main__":
    main()

#!/usr/bin/env node
"use strict";

// Provide OSC 7577 program resume and Herdr compatibility for Polytoken.
// Implemented in Node so Rex's program_differs check unwraps `node <script>`
// to `polytoken-wrap` (Rex does not unwrap bash scripts).

const { spawn, spawnSync } = require("node:child_process");
const crypto = require("node:crypto");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");

function validSessionId(id) {
  return typeof id === "string" && id.length > 0 && !id.startsWith("-") && /^[A-Za-z0-9._-]+$/.test(id);
}

function validPid(pid) {
  return typeof pid === "string" && /^[1-9][0-9]*$/.test(pid);
}

function hasControlChars(str) {
  return /[\x00-\x1f\x7f\u0080-\u009f]/.test(str);
}

function b64Encode(str) {
  return Buffer.from(str, "utf8").toString("base64");
}

function emitOsc7577(sessionId) {
  const tokenFile = process.env.PT_WRAP_TOKEN_FILE || "";
  const tuiPid = process.env.PT_WRAP_TUI_PID || "";
  const cwd = process.env.PT_WRAP_CWD || "";
  const sessionsDir = process.env.HPT_SESSIONS_DIR || "";

  if (!tokenFile || !validPid(tuiPid)) return;

  let token;
  try {
    token = fs.readFileSync(tokenFile, "utf8");
  } catch {
    return;
  }
  if (!token) return;

  const encodedId = sessionId.replace(/-/g, "_");
  const cmd = ["polytoken-wrap", "continue", encodedId];
  if (sessionsDir) {
    cmd.push("--sessions-dir", sessionsDir);
  }

  const encodedArgs = [];
  for (const arg of cmd) {
    if (hasControlChars(arg)) return;
    encodedArgs.push(b64Encode(arg));
  }

  const now = Math.floor(Date.now() / 1000);
  let body = `pid=${tuiPid}:time=${now}:argv=${encodedArgs.join(",")}`;

  if (cwd && cwd.startsWith("/") && !hasControlChars(cwd)) {
    body += `:cwd=${b64Encode(cwd)}`;
  }

  const mac = crypto.createHash("sha256").update(`${body}:${token}`, "utf8").digest("hex");
  if (mac.length !== 64) return;

  try {
    fs.writeFileSync("/dev/tty", `\x1b]7577;${body}:mac=${mac}\x1b\\`);
  } catch {
    // Best-effort write to the controlling terminal; ignore if detached.
  }
}

function handleCallback(args) {
  const action = args[1] || "";
  if (action === "report-agent") {
    let state = "";
    let sessionId = "";
    let seenState = false;
    let seenId = false;
    const opts = new Set(["--source", "--agent", "--state", "--message", "--seq", "--agent-session-id"]);

    let i = 2;
    while (i < args.length) {
      const arg = args[i];
      if (arg === "--") break;
      if (opts.has(arg)) {
        if (i + 1 >= args.length || args[i + 1] === "--") process.exit(2);
        const val = args[i + 1];
        // Message text may itself look like an option.
        if (arg !== "--message" && val.startsWith("--")) process.exit(2);
        if (arg === "--state") {
          if (seenState || !val) process.exit(2);
          seenState = true;
          state = val;
        } else if (arg === "--agent-session-id") {
          if (seenId || !val) process.exit(2);
          seenId = true;
          sessionId = val;
        }
        i += 2;
      } else {
        i += 1;
      }
    }

    if (state !== "working" && state !== "idle" && state !== "blocked") {
      process.exit(2);
    }

    if (seenId && validSessionId(sessionId)) {
      const hcId = process.env.HC_TERMINAL_ID || "";
      if (hcId) {
        try {
          const child = spawn(
            "hc",
            ["label", hcId, `polytoken.session=${sessionId}`, `polytoken.sessions_dir=${process.env.HPT_SESSIONS_DIR || ""}`],
            { detached: true, stdio: "ignore" }
          );
          child.on("error", () => {});
          child.unref();
        } catch {
          // Best-effort label write.
        }
      }
      if (process.env.PT_WRAP_TOKEN_FILE) {
        emitOsc7577(sessionId);
      }
    }
    process.exit(0);
  }

  if (action === "release-agent") {
    // Do not send OSC 7577 clear=1 here: Polytoken may invoke release-agent
    // on SIGHUP/SIGTERM during a terminal restart, when the record must stay.
    // Terminals clear the record automatically when the owning pid exits.
    if (process.env.PT_WRAP_TOKEN_FILE) {
      try {
        fs.unlinkSync(process.env.PT_WRAP_TOKEN_FILE);
      } catch {
        // Ignore cleanup errors.
      }
    }
    process.exit(0);
  }

  if (action === "report-metadata") {
    process.exit(0);
  }

  process.exit(2);
}

function handleRestore(args) {
  if (args.length !== 1) {
    process.stderr.write("Usage: polytoken-wrap restore\n");
    process.exit(2);
  }
  const hcId = process.env.HC_TERMINAL_ID || "";
  if (!hcId) {
    process.stderr.write("polytoken-wrap: restore requires a Herdr terminal\n");
    process.exit(1);
  }

  const res = spawnSync("hc", ["get", "--json", hcId], { encoding: "utf8" });
  if (res.error && res.error.code === "ENOENT") {
    process.stderr.write("polytoken-wrap: restore requires hc\n");
    process.exit(1);
  }
  if (res.status !== 0) {
    process.stderr.write("polytoken-wrap: could not read terminal labels\n");
    process.exit(1);
  }

  let data;
  try {
    data = JSON.parse(res.stdout);
  } catch {
    process.stderr.write("polytoken-wrap: missing or invalid Polytoken session label\n");
    process.exit(1);
  }

  const labels = data && typeof data === "object" && data.labels && typeof data.labels === "object" ? data.labels : null;
  const sessionId = labels ? labels["polytoken.session"] : null;
  if (!validSessionId(sessionId)) {
    process.stderr.write("polytoken-wrap: missing or invalid Polytoken session label\n");
    process.exit(1);
  }

  let sessionsDir = "";
  if (Object.prototype.hasOwnProperty.call(labels, "polytoken.sessions_dir")) {
    const dir = labels["polytoken.sessions_dir"];
    if (typeof dir !== "string" || !dir.startsWith("/") || dir.includes("\0")) {
      process.stderr.write("polytoken-wrap: invalid Polytoken sessions directory label\n");
      process.exit(1);
    }
    sessionsDir = dir;
  }

  process.stderr.write(`polytoken-wrap: restoring session ${sessionId}\n`);
  return sessionsDir ? ["continue", sessionId, "--sessions-dir", sessionsDir] : ["continue", sessionId];
}

function createPrivateTokenFile(token) {
  const dir = process.env.XDG_RUNTIME_DIR || process.env.TMPDIR || os.tmpdir();
  for (let attempt = 0; attempt < 16; attempt++) {
    const name = `polytoken-osc7577.${crypto.randomBytes(8).toString("hex")}`;
    const filePath = path.join(dir, name);
    try {
      const fd = fs.openSync(filePath, "wx", 0o600);
      try {
        fs.writeFileSync(fd, token, "utf8");
      } finally {
        fs.closeSync(fd);
      }
      return filePath;
    } catch (err) {
      if (err && err.code === "EEXIST") continue;
      return "";
    }
  }
  return "";
}

function runPolytoken(args, env, tokenFile) {
  // Let the foreground child receive SIGINT directly from the terminal.
  process.on("SIGINT", () => {});

  const child = spawn("polytoken", args, { stdio: "inherit", env });
  child.on("error", (err) => {
    if (tokenFile) {
      try {
        fs.unlinkSync(tokenFile);
      } catch {}
    }
    process.stderr.write(`polytoken-wrap: failed to launch polytoken: ${err.message}\n`);
    process.exit(err.code === "ENOENT" ? 127 : 126);
  });
  child.on("exit", (code, signal) => {
    if (tokenFile) {
      try {
        fs.unlinkSync(tokenFile);
      } catch {}
    }
    if (signal) {
      process.kill(process.pid, signal);
    } else {
      process.exit(code ?? 1);
    }
  });
}

let args = process.argv.slice(2);

// Keep HPT_REPORTER for callbacks from sessions started with older names.
if (process.env.HPT_REPORTER === "1" && args[0] === "pane") {
  handleCallback(args);
}

if (args[0] === "restore") {
  args = handleRestore(args);
}

// Translate underscores back to hyphens on the positional session ID of `continue`
// so Rex's rex.match.id (which disallows hyphens) can match OSC 7577 resume commands.
if (args[0] === "continue" && args.length >= 2) {
  const skipValue = new Set(["--sessions-dir", "--log-dir", "--config-dir", "--working-dir"]);
  for (let i = 1; i < args.length; i++) {
    const arg = args[i];
    if (arg === "--") break;
    if (skipValue.has(arg)) {
      i += 1;
      continue;
    }
    if (arg.startsWith("-")) continue;
    args[i] = arg.replace(/_/g, "-");
    break;
  }
}

const hcId = process.env.HC_TERMINAL_ID || "";
const oscToken = process.env.OSC7577_TOKEN || "";

// Preserve standalone Polytoken and legacy environments without Herdr or OSC 7577.
if (!hcId && !oscToken) {
  runPolytoken(args, process.env, "");
} else {
  const childEnv = { ...process.env };
  delete childEnv.HPT_SESSIONS_DIR;
  delete childEnv.PT_WRAP_TOKEN_FILE;
  delete childEnv.PT_WRAP_TUI_PID;
  delete childEnv.PT_WRAP_CWD;

  let sessionsDir = "";
  let launchCwd = process.cwd();
  const skipOther = new Set([
    "--log-dir", "--config-dir", "--global-config-dir", "--skills-dir",
    "--facets-dir", "--subagents-dir", "--prompt", "--model", "--facet",
  ]);

  for (let i = 0; i < args.length; i++) {
    const arg = args[i];
    if (arg === "--") break;
    if (arg === "--sessions-dir") {
      i += 1;
      if (i < args.length && args[i] && !args[i].startsWith("--")) {
        sessionsDir = args[i];
      }
    } else if (arg.startsWith("--sessions-dir=")) {
      sessionsDir = arg.slice("--sessions-dir=".length);
    } else if (arg === "--working-dir") {
      i += 1;
      if (i < args.length && args[i] && !args[i].startsWith("--")) {
        launchCwd = args[i];
      }
    } else if (arg.startsWith("--working-dir=")) {
      launchCwd = arg.slice("--working-dir=".length);
    } else if (skipOther.has(arg)) {
      i += 1;
    }
  }

  if (sessionsDir) {
    childEnv.HPT_SESSIONS_DIR = sessionsDir.startsWith("/") ? sessionsDir : path.join(process.cwd(), sessionsDir);
  }
  launchCwd = launchCwd.startsWith("/") ? launchCwd : path.join(process.cwd(), launchCwd);

  let tokenFile = "";
  if (oscToken) {
    tokenFile = createPrivateTokenFile(oscToken);
    if (tokenFile) {
      childEnv.PT_WRAP_TOKEN_FILE = tokenFile;
      childEnv.PT_WRAP_TUI_PID = String(process.pid);
      childEnv.PT_WRAP_CWD = launchCwd;
    }
    delete childEnv.OSC7577_TOKEN;
  }

  let scriptPath = __filename;
  try {
    scriptPath = fs.realpathSync(__filename);
  } catch {
    // Keep __filename if realpath fails.
  }

  childEnv.HPT_REPORTER = "1";
  childEnv.HERDR_ENV = "1";
  childEnv.HERDR_BIN_PATH = scriptPath;
  childEnv.HERDR_PANE_ID = hcId || process.env.REX_BLOCK || `osc7577-${process.pid}`;

  runPolytoken(args, childEnv, tokenFile);
}

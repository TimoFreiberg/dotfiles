#!/usr/bin/env bash
set -euo pipefail
revset='@'
terminal=${HC_TERMINAL_ID:-}
focus=false
while (($#)); do
  case "$1" in
    --to) terminal=${2:?--to needs a terminal}; shift 2 ;;
    --focus) focus=true; shift ;;
    -*) echo "Unknown option: $1" >&2; exit 1 ;;
    *) revset=$1; shift ;;
  esac
done
if [[ -z $terminal ]]; then echo 'Specify --to or set HC_TERMINAL_ID' >&2; exit 1; fi
folder=$(jj root)
space=$(herdr-app ls | jq -r --arg terminal "$terminal" '[.spaces[] | select(any(.tabs[].terminals[]; .terminal == $terminal)) | .id][0] // empty')
if [[ -z $space ]]; then echo "No space for terminal: $terminal" >&2; exit 1; fi
args=$(jq -n --arg space "$space" --arg folder "$folder" --arg revset "$revset" --arg terminal "$terminal" '{space:$space,name:"review",mod:"jj-review",props:{folder:$folder,revset:$revset,terminal:$terminal}}')
before=$(herdr-app status)
result=$(herdr-app do tab.new "$args")
echo "$result"
if $focus; then
  review=$(printf '%s' "$result" | jq -r '.tab')
  herdr-app do space.select --id "$space"
  herdr-app do tab.select --id "$review"
else
  # Creating a tab may move the selection or focus. Put it back.
  after=$(herdr-app status)
  space=$(printf '%s' "$before" | jq -r '.space // empty')
  tab=$(printf '%s' "$before" | jq -r '.tab // empty')
  previous=$(printf '%s' "$before" | jq -r '.focused_pane // empty')
  if [[ -n $space && $space != "$(printf '%s' "$after" | jq -r '.space // empty')" ]]; then herdr-app do space.select --id "$space"; fi
  if [[ -n $tab && $tab != "$(printf '%s' "$after" | jq -r '.tab // empty')" ]]; then herdr-app do tab.select --id "$tab"; fi
  if [[ -n $previous && $previous != "$(printf '%s' "$after" | jq -r '.focused_pane // empty')" ]]; then herdr-app do pane.focus --pane "$previous"; fi
fi

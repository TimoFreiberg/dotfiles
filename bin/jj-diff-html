#!/usr/bin/env node
const { execFileSync } = require('node:child_process');
const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');

const args = process.argv.slice(2);
let rev, from, to, out, watch = false;
function usage() { console.error('Usage: jj-diff-html [-r REVSET | --from REV --to REV] [--out FILE] [--watch]'); process.exit(2); }
for (let i = 0; i < args.length; i++) {
  const a = args[i];
  if (a === '--watch') watch = true;
  else if (['-r', '--from', '--to', '--out'].includes(a) && args[i + 1]) {
    const value = args[++i];
    if (a === '-r') rev = value;
    if (a === '--from') from = value;
    if (a === '--to') to = value;
    if (a === '--out') out = value;
  } else usage();
}
if ((rev && (from || to)) || (!!from !== !!to)) usage();
function jj(...args) { return execFileSync('jj', args, { encoding: 'utf8', maxBuffer: 128 * 1024 * 1024, stdio: ['ignore', 'pipe', 'pipe'] }); }
function main() { try {
  const root = fs.realpathSync(jj('root').trim());
  function diff(...args) { return jj('--config', 'diff.git.show-path-prefix=true', 'diff', '--git', ...args); }
  function selectedRange() { return rev || (!from ? (diff('-r', '@') ? '@' : '@-') : undefined); }
  function changeId(selected) { return jj('log', '-r', selected ? `heads(${selected})` : to, '--no-graph', '-T', 'change_id.short() ++ " " ++ commit_id.short() ++ "\\n"').trim().split('\n').join(' '); }
  if (!out) out = path.join(os.homedir(), '.local/share/polytoken/artifacts/jj-review', `${path.basename(root)}-${changeId(selectedRange()).split(' ')[0]}.html`);
  out = path.resolve(out);
  // Resolve existing ancestors before creating directories, including symlinks.
  let ancestor = path.dirname(out), missing = [];
  while (!fs.existsSync(ancestor)) { missing.unshift(path.basename(ancestor)); ancestor = path.dirname(ancestor); }
  const destination = path.join(fs.realpathSync(ancestor), ...missing, path.basename(out));
  const relative = path.relative(root, destination);
  if (!relative || (!relative.startsWith('..' + path.sep) && relative !== '..' && !path.isAbsolute(relative))) throw new Error('Output path must be outside the reviewed repository');
  let previous;
  function update() {
    const selected = selectedRange();
    const range = selected || `${from}..${to}`;
    const patch = diff(...(selected ? ['-r', selected] : ['--from', from, '--to', to]));
    if (patch === previous) return;
    const change = changeId(selected);
    const logRev = selected || `(${from})..(${to})`;
    const commits = jj('log', '-r', logRev, '--no-graph', '-T', 'change_id.short() ++ " " ++ commit_id.short() ++ " " ++ description.first_line() ++ "\\n"').trim();
    const data = { root, range, change, commits, patch, generated: new Date().toISOString() };
    const json = JSON.stringify(data).replace(/</g, '\\u003c');
    fs.mkdirSync(path.dirname(out), { recursive: true });
    const temp = path.join(path.dirname(out), `.jj-review-${require('node:crypto').randomUUID()}.tmp`);
    try {
      fs.writeFileSync(temp, html.replace('<!-- DATA -->', () => json), { flag: 'wx' });
      fs.renameSync(temp, out);
    } finally { fs.rmSync(temp, { force: true }); }
    if (previous === undefined) {
      try { execFileSync('herdr-artifact', ['add', out], { stdio: 'inherit' }); }
      catch (e) { if (e.code !== 'ENOENT') console.error(`Artifact registration failed: ${e.message}`); }
    }
    previous = patch;
    console.log(`Wrote ${out}`);
  }
  update();
  if (watch) setInterval(() => { try { update(); } catch (e) { console.error(e.stderr?.toString() || e.message); } }, 3000);
} catch (e) { console.error(e.stderr?.toString() || e.message); process.exitCode = 1; } }

const html = `<!doctype html>
<html lang="en" data-lavish-annotate="off"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>jj diff review</title>
<style>
:root{color-scheme:dark;font:14px system-ui;background:#111419;color:#d9dce2}*{box-sizing:border-box}body{margin:0}header{padding:18px 24px;border-bottom:1px solid #30363e;background:#171b21}h1{font-size:19px;margin:0 0 6px}header p{margin:4px 0;color:#aab2bd}pre.commits{white-space:pre-wrap;margin:8px 0 0;color:#aab2bd;font-size:12px}.toolbar{display:flex;gap:8px;align-items:center;margin-top:12px}button{background:#282f39;color:#e3e7ed;border:1px solid #444d59;border-radius:5px;padding:6px 10px;cursor:pointer}button:hover{background:#354151}button[aria-pressed=true]{background:#365b83}main{display:grid;grid-template-columns:260px minmax(0,1fr);align-items:start}aside{position:sticky;top:0;max-height:100vh;overflow:auto;padding:16px;border-right:1px solid #30363e}aside a{display:flex;gap:8px;justify-content:space-between;color:#c5cbd3;text-decoration:none;padding:7px;overflow-wrap:anywhere}aside a:hover{background:#252b34}aside small{white-space:nowrap}section#files{min-width:0;padding:16px}.file{border:1px solid #343b45;border-radius:6px;margin-bottom:16px;overflow:hidden}.filebar{display:flex;gap:12px;align-items:center;padding:10px 12px;background:#222831}.filebar button{font:inherit;text-align:left;overflow-wrap:anywhere;flex:1;background:none;border:0;padding:0}.filebar label{white-space:nowrap}.plus{color:#65c889}.minus{color:#f18585}.binary,.error{padding:16px;color:#b9c1cb}.comment{padding:12px;border-top:1px solid #343b45;background:#20262e}.comment textarea{display:block;width:100%;min-height:70px;margin:8px 0;background:#111419;color:inherit;border:1px solid #56616e;border-radius:4px;padding:8px}.comment p{margin:0;color:#c5cbd3}.comment pre{white-space:pre-wrap;max-height:12em;overflow:auto}.comment[hidden],.diff[hidden]{display:none}@media(max-width:700px){main{grid-template-columns:1fr}aside{position:static;max-height:200px;border-right:0;border-bottom:1px solid #30363e}}
</style></head><body><header><h1>Diff review</h1><p id="meta"></p><pre class="commits" id="commits"></pre><div class="toolbar"><button id="unified" aria-pressed="true">Unified</button><button id="split" aria-pressed="false">Split</button><span> Select line numbers to comment; use Lavish Send to deliver.</span></div></header><main><aside id="nav"></aside><section id="files"></section></main><script type="application/json" id="data"><!-- DATA --></script>
<script type="module">
import { parsePatchFiles, FileDiff } from 'https://esm.sh/@pierre/diffs@1.6.2';
const data=JSON.parse(document.getElementById('data').textContent);
const byId=id=>document.getElementById(id);
byId('meta').textContent=data.root+' · '+data.range+' · '+data.change+' · '+data.generated;
byId('commits').textContent=data.commits || 'No commits';
const key='jj-review:viewed:'+data.root+':'+data.change.split(' ')[0];
let viewed; try{viewed=JSON.parse(localStorage.getItem(key)||'{}')}catch{viewed={};const note=document.createElement('span');note.textContent=' Viewed state lasts only until reload in Lavish.';document.querySelector('.toolbar').append(note)}
let style='unified'; const instances=[];
function quote(file,range){
  const side=range.side||'additions', endSide=range.endSide||side;
  if(side!==endSide) return '(selection crosses old and new sides)';
  const start=Math.min(range.start,range.end),end=Math.max(range.start,range.end), result=[];
  for(const h of file.hunks){const first=side==='additions'?h.additionStart:h.deletionStart, index=side==='additions'?h.additionLineIndex:h.deletionLineIndex, count=side==='additions'?h.additionCount:h.deletionCount, lines=side==='additions'?file.additionLines:file.deletionLines; for(let n=Math.max(start,first);n<=Math.min(end,first+count-1);n++)result.push(n+': '+(lines[index+n-first]||'').replace(/\\n$/, ''));}
  return result.join('\\n');
}
function showComment(file,range,box){if(!range)return; const side=range.side||'additions', endSide=range.endSide||side; if(side!==endSide){box.hidden=false;box.querySelector('p').textContent='Select lines on one side at a time.';box.querySelector('textarea').disabled=true;box.querySelector('button').disabled=true;return} const start=Math.min(range.start,range.end),end=Math.max(range.start,range.end), where=file.name+':'+start+(start===end?'':'-'+end), text=quote(file,range); box.hidden=false;box.querySelector('p').textContent=where+' ('+(side==='deletions'?'old':'new')+')';box.querySelector('pre').textContent=text; const input=box.querySelector('textarea'),button=box.querySelector('button');input.disabled=false;button.disabled=false;button.onclick=()=>{if(!input.value.trim())return;if(!window.lavish?.queuePrompt){box.querySelector('p').textContent='Open this page through Lavish to queue a comment.';return}window.lavish.queuePrompt(where+' ('+(side==='deletions'?'old':'new')+')\\n'+text+'\\n\\n'+input.value.trim(),{tag:'code-comment',text:where});input.value='';box.hidden=true};}
function render(){for(const item of instances){item.view.setOptions({theme:'github-dark',themeType:'dark',diffStyle:style,disableFileHeader:true,enableLineSelection:true,onLineSelectionEnd:r=>showComment(item.file,r,item.box)});item.view.render({fileDiff:item.file,containerWrapper:item.host,forceRender:true});}}
try{
 const chunks=data.patch.split(/(?=^diff --git )/m).filter(x=>x.startsWith('diff --git '));
 if(!chunks.length)byId('files').textContent='No changes in this range.';
 chunks.forEach((chunk,i)=>{
  let file; try{file=parsePatchFiles(chunk).flatMap(p=>p.files)[0]}catch{};
  const name=file?.name || (chunk.match(/^diff --git a\\/(.*?) b\\/(.*)$/m)||[])[2] || 'Binary or unrecognized file';
  const add=file?.hunks.reduce((n,h)=>n+h.additionLines,0)||0,del=file?.hunks.reduce((n,h)=>n+h.deletionLines,0)||0;
  const article=document.createElement('article');article.className='file';article.id='file-'+i;
  const bar=document.createElement('div');bar.className='filebar';const toggle=document.createElement('button');toggle.textContent=name;toggle.setAttribute('aria-expanded','true');bar.append(toggle);
  const counts=document.createElement('span');counts.innerHTML='<span class="plus">+'+add+'</span> <span class="minus">−'+del+'</span>';bar.append(counts);
  const label=document.createElement('label'),check=document.createElement('input');check.type='checkbox';check.checked=!!viewed[name];label.append(check,' Viewed');bar.append(label);article.append(bar);
  const host=document.createElement('div');host.className='diff';article.append(host);const box=document.createElement('div');box.className='comment';box.hidden=true;box.innerHTML='<p></p><pre></pre><textarea aria-label="Comment" placeholder="Write a comment"></textarea><button type="button">Queue comment</button>';article.append(box);
  const setOpen=open=>{host.hidden=!open;toggle.setAttribute('aria-expanded',String(open));if(!open)box.hidden=true};toggle.onclick=()=>setOpen(host.hidden);check.onchange=()=>{viewed[name]=check.checked;try{localStorage.setItem(key,JSON.stringify(viewed))}catch{};if(check.checked)setOpen(false)};
  const link=document.createElement('a');link.href='#'+article.id;const nameNode=document.createElement('span');nameNode.textContent=name;const nums=document.createElement('small');nums.innerHTML='<span class="plus">+'+add+'</span> <span class="minus">−'+del+'</span>';link.append(nameNode,nums);byId('nav').append(link);byId('files').append(article);
  if(file?.hunks.length){const view=new FileDiff();instances.push({view,file,host,box});}else{host.classList.add('binary');host.textContent=chunk.includes('Binary files')||chunk.includes('GIT binary patch')?'Binary file changed':'No textual changes';}
  if(check.checked)setOpen(false);
 });
 render();
 for(const mode of ['unified','split'])byId(mode).onclick=()=>{style=mode;for(const m of ['unified','split'])byId(m).setAttribute('aria-pressed',String(m===mode));render()};
}catch(e){const p=document.createElement('p');p.className='error';p.textContent='Could not render diff: '+e.message;byId('files').append(p);console.error(e)}
</script></body></html>`;
main();

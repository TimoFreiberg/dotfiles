[
  {
    "name": "load-local-agent-context-at-start",
    "event": "session_start",
    "handler": {
      "bash": "python3 \"$HOME/dotfiles/agents/hooks/load-local-agent-context.py\""
    }
  },
  {
    "name": "load-local-agent-context-after-clear",
    "event": "post_clear",
    "handler": {
      "bash": "python3 \"$HOME/dotfiles/agents/hooks/load-local-agent-context.py\""
    }
  },
  {
    "name": "load-local-agent-context-after-compaction",
    "event": "post_compaction",
    "handler": {
      "bash": "python3 \"$HOME/dotfiles/agents/hooks/load-local-agent-context.py\""
    }
  },
  {
    "name": "lavish-plan-view",
    "event": "pre_tool_use",
    "matcher": "handoff_plan",
    "handler": {
      "bash": "\"$HOME/dotfiles/agents/hooks/lavish-plan-view\""
    }
  }
]
